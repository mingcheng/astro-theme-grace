---
import { styleguideSections, type StyleguideSectionId } from '@/data/styleguide';
import { padNumber } from '@/lib/format';

interface Props {
  id: StyleguideSectionId;
}

const { id } = Astro.props;
const index = styleguideSections.findIndex((section) => section.id === id);
const { label } = styleguideSections[index];
---

<section class="section" aria-labelledby={id}>
  <div class="section-label">
    <span>{padNumber(index + 1)}</span>
    <h2 id={id}>{label}</h2>
  </div>
  <div class="section-body">
    <slot />
  </div>
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 3rem;
    padding: 4rem 0;
    border-top: 1px solid var(--line);
  }

  .section-label span,
  .section-body :global(.annotation) {
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.68rem;
  }

  .section-label h2 {
    margin: 0.35rem 0;
    font-size: 1rem;
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .section {
      grid-template-columns: 1fr;
    }
  }
</style>
