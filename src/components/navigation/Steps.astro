---
import Icon from '@/components/ui/Icon.astro';
import { padNumber } from '@/lib/format';

interface Step {
  title: string;
  description?: string;
}

interface Props {
  steps: Step[];
  current: number;
  label?: string;
}

const { steps, current, label = '步骤进度' } = Astro.props;
const stateLabels = { done: '已完成', current: '进行中', upcoming: '未开始' } as const;
const items = steps.map((step, index) => ({
  ...step,
  state: index < current ? 'done' as const : index === current ? 'current' as const : 'upcoming' as const,
}));
---

<ol class="steps" aria-label={label}>
  {items.map((step, index) => (
    <li class={step.state} aria-current={step.state === 'current' ? 'step' : undefined}>
      <span class="marker" aria-hidden="true">
        {step.state === 'done' ? <Icon name="check" size={14} /> : padNumber(index + 1)}
      </span>
      <div>
        <strong>{step.title}<span class="visually-hidden">（{stateLabels[step.state]}）</span></strong>
        {step.description && <p>{step.description}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .steps {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding-top: 1rem;
    border-top: 2px solid var(--line);
  }

  .marker {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    color: var(--muted);
    border: 1px solid var(--line);
    font-family: var(--sans);
    font-size: 0.66rem;
  }

  strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 500;
  }

  p {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.7rem;
    line-height: 1.6;
  }

  .done {
    border-top-color: var(--ink);
  }

  .done .marker {
    color: var(--paper);
    border-color: var(--ink);
    background: var(--ink);
  }

  .current {
    border-top-color: var(--accent);
  }

  .current .marker {
    color: var(--accent);
    border-color: var(--accent);
  }

  .upcoming strong {
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .steps {
      grid-auto-flow: row;
    }

    li {
      grid-template-columns: auto 1fr;
      gap: 1rem;
    }
  }
</style>
