---
interface Item {
  term: string;
  detail: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<dl class="description-list">
  {items.map((item) => (
    <div>
      <dt>{item.term}</dt>
      <dd>{item.detail}</dd>
    </div>
  ))}
</dl>

<style>
  dl {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  div {
    display: grid;
    grid-template-columns: minmax(6rem, 0.35fr) 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.72rem;
    line-height: 1.9;
  }

  dd {
    margin: 0;
    font-size: 0.95rem;
  }

  @media (max-width: 480px) {
    div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
