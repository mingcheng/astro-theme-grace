---
interface Props {
  values: number[];
  label: string;
  unit?: string;
}

const { values, label, unit = '' } = Astro.props;
const width = 480;
const height = 144;
const min = Math.min(...values);
const max = Math.max(...values);
const range = max - min || 1;
const points = values
  .map((value, index) => {
    const x = values.length > 1 ? (index / (values.length - 1)) * width : width / 2;
    const y = height - ((value - min) / range) * (height - 24) - 12;
    return `${x},${y}`;
  })
  .join(' ');
const areaPoints = `0,${height} ${points} ${width},${height}`;
const latest = values.at(-1) ?? 0;
---

<figure class="sparkline">
  <figcaption><span>{label}</span><strong>{latest}{unit}</strong></figcaption>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${label}，当前 ${latest}${unit}`}>
    <defs>
      <linearGradient id="spark-fill" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0%" style="stop-color: var(--accent); stop-opacity: 0.22" />
        <stop offset="100%" style="stop-color: var(--accent); stop-opacity: 0" />
      </linearGradient>
    </defs>
    <path class="grid" d={`M0 ${height / 2}H${width} M0 ${height - 1}H${width}`} />
    <polygon points={areaPoints} fill="url(#spark-fill)" />
    <polyline points={points} />
  </svg>
</figure>

<style>
  .sparkline {
    margin: 0;
  }

  figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  figcaption span {
    color: var(--muted);
    font-family: var(--sans);
    font-size: var(--text-xs);
  }

  figcaption strong {
    font-size: var(--h4);
    font-weight: 500;
  }

  svg {
    width: 100%;
    overflow: visible;
  }

  polyline {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .grid {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
</style>
