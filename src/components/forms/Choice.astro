---
interface Props {
  id: string;
  label: string;
  type?: 'checkbox' | 'radio' | 'switch';
  name?: string;
  value?: string;
  description?: string;
  checked?: boolean;
  disabled?: boolean;
  required?: boolean;
}

const {
  id,
  label,
  type = 'checkbox',
  name = id,
  value,
  description,
  checked = false,
  disabled = false,
  required = false,
} = Astro.props;
---

<label class:list={['choice', type, { disabled }]} for={id}>
  <input
    id={id}
    type={type === 'radio' ? 'radio' : 'checkbox'}
    role={type === 'switch' ? 'switch' : undefined}
    name={name}
    value={value}
    checked={checked}
    disabled={disabled}
    required={required}
  />
  <span class="choice-text">
    <span>{label}</span>
    {description && <small>{description}</small>}
  </span>
</label>

<style>
  .choice {
    display: inline-flex;
    gap: 0.65rem;
    align-items: flex-start;
    color: var(--ink);
    font-family: var(--sans);
    font-size: var(--text-sm);
    line-height: 1.5;
    cursor: pointer;
  }

  .choice.disabled {
    color: var(--muted);
    cursor: not-allowed;
  }

  input {
    display: grid;
    flex: none;
    place-content: center;
    width: 1rem;
    height: 1rem;
    margin: 0.15rem 0 0;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    background: var(--surface);
    appearance: none;
    cursor: inherit;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  input::before {
    content: '';
    transform: scale(0);
    transition: transform 160ms ease;
  }

  input:checked {
    border-color: var(--ink);
  }

  input:checked::before {
    transform: scale(1);
  }

  input:disabled {
    background: var(--paper-deep);
  }

  .checkbox input:checked {
    background: var(--ink);
  }

  .checkbox input::before {
    width: 0.55rem;
    height: 0.3rem;
    margin-top: -0.1rem;
    border-bottom: 1.5px solid var(--paper);
    border-left: 1.5px solid var(--paper);
    transform: rotate(-45deg) scale(0);
  }

  .checkbox input:checked::before {
    transform: rotate(-45deg) scale(1);
  }

  .radio input::before {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--ink);
  }

  .switch input {
    place-content: center start;
    width: 2rem;
    height: 1.1rem;
    padding: 0 0.15rem;
  }

  .switch input::before {
    width: 0.7rem;
    height: 0.7rem;
    background: var(--line-strong);
    transform: none;
  }

  .switch input:checked {
    background: var(--ink);
  }

  .switch input:checked::before {
    background: var(--paper);
    transform: translateX(0.95rem);
  }

  .choice-text {
    display: grid;
    gap: 0.1rem;
  }

  small {
    color: var(--muted);
    font-size: var(--text-xs);
  }
</style>
