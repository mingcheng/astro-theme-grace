---
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/data/icons';

interface Props {
  title: string;
  description?: string;
  icon?: IconName;
}

const { title, description, icon = 'inbox' } = Astro.props;
const hasActions = Astro.slots.has('actions');
---

<div class="empty">
  <span class="empty-icon"><Icon name={icon} size={26} /></span>
  <p class="empty-title">{title}</p>
  {description && <p class="empty-description">{description}</p>}
  {hasActions && <div class="empty-actions"><slot name="actions" /></div>}
</div>

<style>
  .empty {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    padding: clamp(2rem, 6vw, 3.5rem) 1.5rem;
    border: 1px dashed var(--line-strong);
    text-align: center;
  }

  .empty-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 0.4rem;
    color: var(--muted);
    border: 1px solid var(--line);
    background: var(--paper-deep);
  }

  p {
    margin: 0;
  }

  .empty-title {
    font-size: 1.15rem;
    font-weight: 500;
  }

  .empty-description {
    max-width: 26rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 0.8rem;
  }
</style>
