---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  label: string;
  for?: string;
  hint?: string;
  hintId?: string;
  error?: string;
  errorId?: string;
  required?: boolean;
  as?: 'div' | 'fieldset';
}

const { label, for: htmlFor, hint, hintId, error, errorId, required = false, as = 'div' } = Astro.props;
const Tag = as;
---

<Tag class="field">
  {as === 'fieldset' ? (
    <legend class="field-label">{label}{required && <span class="required" aria-hidden="true">*</span>}</legend>
  ) : (
    <label class="field-label" for={htmlFor}>{label}{required && <span class="required" aria-hidden="true">*</span>}</label>
  )}
  <slot />
  {hint && <p id={hintId} class="field-hint">{hint}</p>}
  {error && <p id={errorId} class="field-error"><Icon name="alert" size={13} />{error}</p>}
</Tag>

<style>
  .field {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    padding: 0;
    margin: 0;
    border: 0;
  }

  .field-label {
    padding: 0;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 500;
  }

  legend.field-label {
    margin-bottom: 0.75rem;
  }

  .required {
    margin-left: 0.2rem;
    color: var(--accent);
  }

  .field-hint,
  .field-error {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    margin: 0;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.68rem;
    line-height: 1.5;
  }

  .field-error {
    color: var(--critical);
  }
</style>
