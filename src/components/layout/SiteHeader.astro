---
import { navLinks, SITE } from "@/data/site";
import { withBase } from "@/lib/urls";

const { pathname } = Astro.url;
const isActive = (href: string) => {
  const url = withBase(href);
  return pathname === url || (href !== "/" && pathname.startsWith(`${url}/`));
};
---

<header class="header">
  <div class="container header-inner">
    <a class="mark" href={withBase("/")} aria-label={`${SITE.name}的首页`}>
      <img src={withBase("/favicon.svg")} alt="" width="32" height="32" />
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="主要导航">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a
                href={withBase(link.href)}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 82px;
  }

  .mark {
    display: inline-flex;
    gap: 0.75rem;
    align-items: center;
    color: var(--ink);
    font-size: var(--text-lg);
    font-family: var(--title);
    font-weight: 600;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.4rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  nav a {
    padding-block: 0.5rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  @media (max-width: 480px) {
    .header-inner {
      min-height: 68px;
    }

    .mark span {
      display: none;
    }

    nav ul {
      gap: 0.85rem;
    }

    nav a {
      font-size: var(--text-xs);
    }
  }
</style>
