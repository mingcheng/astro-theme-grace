---
import Accordion from '@/components/content/Accordion.astro';
import Card from '@/components/content/Card.astro';
import CodeBlock from '@/components/content/CodeBlock.astro';
import DescriptionList from '@/components/content/DescriptionList.astro';
import Figure from '@/components/content/Figure.astro';
import NoteCard from '@/components/content/NoteCard.astro';
import Quote from '@/components/content/Quote.astro';
import Timeline from '@/components/content/Timeline.astro';
import DataTable from '@/components/data/DataTable.astro';
import DonutChart from '@/components/data/DonutChart.astro';
import MetricCard from '@/components/data/MetricCard.astro';
import ProgressBar from '@/components/data/ProgressBar.astro';
import Sparkline from '@/components/data/Sparkline.astro';
import StatusBadge from '@/components/data/StatusBadge.astro';
import Alert from '@/components/feedback/Alert.astro';
import Dialog from '@/components/feedback/Dialog.astro';
import EmptyState from '@/components/feedback/EmptyState.astro';
import Skeleton from '@/components/feedback/Skeleton.astro';
import Choice from '@/components/forms/Choice.astro';
import Field from '@/components/forms/Field.astro';
import RadioGroup from '@/components/forms/RadioGroup.astro';
import SelectField from '@/components/forms/SelectField.astro';
import TextField from '@/components/forms/TextField.astro';
import Breadcrumb from '@/components/navigation/Breadcrumb.astro';
import Pagination from '@/components/navigation/Pagination.astro';
import Steps from '@/components/navigation/Steps.astro';
import TableOfContents from '@/components/navigation/TableOfContents.astro';
import Tabs from '@/components/navigation/Tabs.astro';
import Specimen from '@/components/styleguide/Specimen.astro';
import StyleguideSection from '@/components/styleguide/StyleguideSection.astro';
import Avatar from '@/components/ui/Avatar.astro';
import Dropdown from '@/components/ui/Dropdown.astro';
import Heading from '@/components/ui/Heading.astro';
import Icon from '@/components/ui/Icon.astro';
import Pill from '@/components/ui/Pill.astro';
import Tooltip from '@/components/ui/Tooltip.astro';
import { storageSegments, trafficTrend } from '@/data/dashboard';
import { iconLabels, type IconName } from '@/data/icons';
import {
  avatarGroup,
  collaborationOptions,
  colorTokens,
  dropdownItems,
  exampleCode,
  faqItems,
  headingScale,
  nodeTable,
  regionOptions,
  sampleImage,
  signupSteps,
  styleguideSections,
  timelineItems,
} from '@/data/styleguide';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { codeFrameTransformer } from '@/lib/code-block';
import { formatChineseDate, toISODate } from '@/lib/format';
import { getNotes } from '@/lib/notes';
import { withBase } from '@/lib/urls';
import { Code } from 'astro:components';
import katex from 'katex';

const notes = await getNotes();
const iconNames = Object.keys(iconLabels) as IconName[];
const bylineDate = new Date('2026-09-12T00:00:00+08:00');
// 与 Markdown 中 $...$ / $$...$$ 走同一套 KaTeX 渲染，展示行内与块级公式的实际效果。
const inlineFormula = katex.renderToString('E = mc^2', { throwOnError: false });
const blockFormula = katex.renderToString('x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}', {
  throwOnError: false,
  displayMode: true,
});
---

<BaseLayout title="元素规范" description="站点的字体、颜色与界面元素展示。">
  <header class="intro container">
    <p class="eyebrow">Design system / v1.2</p>
    <h1 class="display">元素与<br />排版规范</h1>
    <div class="intro-aside">
      <p>一份为简体中文阅读优化的基础视觉语言，也是一页可供维护与回归检查的组件清单。</p>
      <TableOfContents items={[...styleguideSections]} title="组件目录" />
    </div>
  </header>

  <div class="catalog container">
    <StyleguideSection id="colors">
      <div class="colors">
        {colorTokens.map(({ name, token, value }) => (
          <div class="swatch">
            <span style={`--swatch: var(${token})`}></span>
            <strong>{name}</strong>
            <code>{token} · {value}</code>
          </div>
        ))}
      </div>
    </StyleguideSection>

    <StyleguideSection id="type">
      <div class="type-samples">
        <div>
          <span class="annotation">展示标题 · H1 · 36–56px</span>
          <p class="display">清醒地创造</p>
        </div>
        <div>
          <span class="annotation">章节标题 · H2 · 30–44px</span>
          <p class="section-title">好的设计从理解开始</p>
        </div>
        <div class="body-sample">
          <span class="annotation">正文 · 16–18px / 1.8–2.0</span>
          <p>中文阅读强调稳定而连贯的节奏。适当的行长、充足的行距与克制的字重，让信息可以被从容地理解，也让版面在不同尺寸的屏幕上保持呼吸感。</p>
        </div>
      </div>
    </StyleguideSection>

    <StyleguideSection id="headings">
      <div class="stack">
        <div class="heading-scale">
          {headingScale.map((item) => (
            <div class="heading-scale-item">
              <span class="annotation">{item.note}</span>
              <Heading title={item.title} level={3} size={item.size} />
            </div>
          ))}
        </div>
        <Specimen label="眉题 + 标题 + 说明">
          <Heading
            level={3}
            size="section"
            eyebrow="最近写作 / 02"
            title="关于创造与生活的笔记"
            description="标题组件统一了眉题、标题与导语的间距。语义层级由 level 决定，视觉尺寸由 size 独立控制。"
          />
        </Specimen>
        <div class="grid">
          <Specimen label="居中对齐">
            <Heading level={3} size="title" align="center" eyebrow="继续阅读" title="慢一点，也没关系" />
          </Specimen>
          <Specimen label="附带操作">
            <Heading level={3} size="subtitle" eyebrow="网络 / 过去 12 小时" title="入站流量">
              <a slot="actions" href={withBase('/dashboard')}>查看全部 →</a>
            </Heading>
          </Specimen>
        </div>
      </div>
    </StyleguideSection>

    <StyleguideSection id="prose">
      <div class="prose prose-sample">
        <p>
          正文中可以使用<strong>加粗强调</strong>、<em>语气强调</em>、<a href="#prose">行内链接</a>与<mark>高亮标记</mark>；
          技术说明可使用 <code>npm run build</code> 行内代码与 <kbd>⌘</kbd> + <kbd>K</kbd> 快捷键；
          修订内容以<del>删除线</del>表示，缩写如 <abbr title="内容分发网络">CDN</abbr> 可悬停查看全称，
          上下标如 H<sub>2</sub>O 与 10<sup>3</sup>。
        </p>
        <p>
          Markdown 中的 <code>$...$</code> 与 <code>$$...$$</code> 会经 KaTeX 渲染为数学公式，
          例如质能方程 <Fragment set:html={inlineFormula} /> 可直接嵌入行内：
        </p>
        <Fragment set:html={blockFormula} />
        <p>
          围栏代码块由 Shiki 在构建时高亮，标题栏显示语言，可用 <code>title="文件名"</code> 标注来源，右侧按钮一键复制：
        </p>
        <Code code={exampleCode} lang="ts" meta='title="src/monitor.ts"' theme="css-variables" transformers={[codeFrameTransformer]} />
        <Code code="deno task build" lang="bash" theme="css-variables" transformers={[codeFrameTransformer]} />
        <ul>
          <li>无序列表适合并列的要点。</li>
          <li>列表符号使用强调色，保持克制的视觉提示。</li>
        </ul>
        <ol>
          <li>有序列表用于存在先后顺序的步骤。</li>
          <li>序号与正文保持相同的阅读节奏。</li>
        </ol>
        <hr />
        <Quote cite="林知夏，《为平静而设计》">好的设计不是让人停留更久，而是让人更安心地离开。</Quote>
        <DescriptionList
          items={[
            { term: '作者', detail: '林知夏' },
            { term: '发布日期', detail: '2026 年 9 月 12 日' },
            { term: '分类', detail: '设计 · 中文排版' },
          ]}
        />
      </div>
    </StyleguideSection>

    <StyleguideSection id="images">
      <div class="stack">
        <div class="grid">
          <Specimen label="头像 · 图片 sm / md / lg / xl">
            <div class="row">
              <Avatar name="林知夏" src={sampleImage.src} size="sm" />
              <Avatar name="林知夏" src={sampleImage.src} />
              <Avatar name="林知夏" src={sampleImage.src} size="lg" />
              <Avatar name="林知夏" src={sampleImage.src} size="xl" />
            </div>
          </Specimen>
          <Specimen label="头像 · 无图片时显示姓名缩写">
            <div class="row">
              <Avatar name="林知夏" size="sm" />
              <Avatar name="周予安" />
              <Avatar name="Ada Lovelace" size="lg" />
              <Avatar name="陈默" size="xl" />
            </div>
          </Specimen>
          <Specimen label="头像 · 作者署名">
            <div class="byline">
              <Avatar name="林知夏" src={sampleImage.src} size="lg" />
              <div>
                <strong>林知夏</strong>
                <span>设计师与写作者 · <time datetime={toISODate(bylineDate)}>{formatChineseDate(bylineDate)}</time></span>
              </div>
            </div>
          </Specimen>
          <Specimen label="头像 · 叠放头像组">
            <div class="row">
              <div class="avatar-group">
                {avatarGroup.map((person) => <Avatar {...person} />)}
              </div>
              <span class="group-note">等 16 位读者收藏了这篇文章</span>
            </div>
          </Specimen>
        </div>
        <Specimen label="正文插图 · Figure 通栏裁切 / 收窄居中 / 图文环绕">
          <div class="prose prose-sample">
            <p>插图与正文共享同一条阅读轴线。通栏插图可以通过 <code>ratio</code> 裁切为统一比例，让版面节奏保持稳定。</p>
            <Figure {...sampleImage} ratio="16 / 9" caption="图 1 · 通栏插图，按 16:9 裁切并占满正文宽度" />
            <p>竖幅或方形图片不宜撑满整栏，可以收窄居中，保留原图比例。</p>
            <Figure {...sampleImage} layout="narrow" caption="图 2 · 收窄居中，保持原图比例" />
            <Figure {...sampleImage} layout="start" caption="图 3 · 左侧环绕" />
            <p>较小的配图可以浮动在文字一侧，形成图文环绕。浮动插图的宽度不超过正文的四成，说明文字仍以细线引出，与正文保持距离。</p>
            <p>在窄屏上，环绕插图会自动恢复为整行显示，避免文字被挤压成过窄的一列。下一个章节标题会清除浮动，不会与插图并排。</p>
          </div>
        </Specimen>
        <Specimen label="Markdown 插图 · ![说明](地址)">
          <div class="prose prose-sample">
            <p>在 Markdown 中直接插入图片时，只含图片的段落会取消首行缩进，并获得与 Figure 一致的描边。</p>
            <p><img src={withBase(sampleImage.src)} alt={sampleImage.alt} width={sampleImage.width} height={sampleImage.height} loading="lazy" decoding="async" /></p>
            <p>需要图注、裁切或环绕时，请改用 <code>Figure</code> 组件。</p>
          </div>
        </Specimen>
      </div>
    </StyleguideSection>

    <StyleguideSection id="components">
      <div class="grid">
        <Specimen label="标签 · default / accent / quiet">
          <div class="row">
            <Pill label="默认标签" />
            <Pill label="强调标签" tone="accent" />
            <Pill label="安静标签" tone="quiet" />
          </div>
        </Specimen>
        <Specimen label="头像 · sm / md / lg">
          <div class="row">
            <Avatar name="林知夏" size="sm" />
            <Avatar name="林知夏" />
            <Avatar name="Ada Lovelace" size="lg" />
          </div>
        </Specimen>
        <Specimen label="链接与按钮" wide>
          <div class="row">
            <a href="#components">文字链接 ↗</a>
            <a class="button" href="#components">主要操作 →</a>
            <button class="button quiet" type="button">次要操作</button>
            <button class="button" type="button"><Icon name="download" size={16} />导出数据</button>
            <button class="button quiet" type="button"><Icon name="plus" size={16} />新建</button>
            <button class="button" type="button" disabled>不可用</button>
          </div>
        </Specimen>
        <Specimen label="提示气泡 · 悬停或聚焦">
          <div class="row">
            <Tooltip text="复制当前页面链接">
              <button class="button quiet" type="button">分享</button>
            </Tooltip>
            <Tooltip text="支持中文、英文与数字" placement="bottom">
              <button class="icon-button" type="button" aria-label="输入说明"><Icon name="info" size={18} /></button>
            </Tooltip>
          </div>
        </Specimen>
        <Specimen label="下拉菜单">
          <div class="row">
            <Dropdown label="更多操作" items={dropdownItems} />
          </div>
        </Specimen>
      </div>
    </StyleguideSection>

    <StyleguideSection id="forms">
      <div class="form-grid">
        <TextField id="form-name" label="姓名" placeholder="请输入姓名" required />
        <TextField id="form-email" label="电子邮箱" type="email" placeholder="name@example.com" hint="仅用于接收回复，不会公开。" />
        <SelectField id="form-region" label="所在地区" options={regionOptions} placeholder="请选择地区" />
        <TextField id="form-website" label="个人网站" type="url" value="example" error="请输入以 https:// 开头的完整网址。" />
        <div class="wide">
          <TextField id="form-message" label="留言" multiline placeholder="想聊些什么？" hint="最多 500 字。" />
        </div>
        <RadioGroup name="form-collaboration" legend="合作类型" value="design" options={collaborationOptions} />
        <Field as="fieldset" label="偏好设置">
          <div class="stack compact">
            <Choice id="form-newsletter" label="订阅每月通讯" checked />
            <Choice id="form-terms" label="我已阅读隐私说明" description="提交即表示同意。" />
            <Choice id="form-reminder" type="switch" label="夜间提醒" checked />
            <Choice id="form-sync" type="switch" label="自动同步" disabled />
          </div>
        </Field>
        <TextField id="form-disabled" label="账户编号" value="LZX-2026-0912" disabled />
        <Field label="订阅更新" for="subscribe-email">
          <div class="input-row">
            <input class="control" id="subscribe-email" type="email" placeholder="name@example.com" />
            <button class="button" type="button">订阅</button>
          </div>
        </Field>
      </div>
    </StyleguideSection>

    <StyleguideSection id="feedback">
      <div class="stack">
        <Alert title="新功能">文章归档现已支持分页浏览。</Alert>
        <Alert tone="healthy" title="保存成功">你的偏好设置已更新。</Alert>
        <Alert tone="warning">磁盘空间即将不足，建议清理旧日志。</Alert>
        <Alert tone="critical" title="同步失败">
          无法连接到 backup-hongkong-01，请稍后重试。
          <button slot="actions" class="button quiet" type="button">重试</button>
        </Alert>
        <div class="grid">
          <EmptyState title="暂无文章" description="这个分类下还没有内容，换个分类看看，或者稍后再来。">
            <a slot="actions" class="button quiet" href={withBase('/notes')}>浏览全部文章</a>
          </EmptyState>
          <Specimen label="加载占位">
            <Skeleton avatar lines={3} />
            <Skeleton lines={2} />
          </Specimen>
        </div>
        <Specimen label="对话框 · 原生 popover，可按 Esc 或点击遮罩关闭">
          <div class="row">
            <Dialog id="demo-dialog" title="删除这篇草稿？" triggerLabel="打开对话框">
              删除后将无法恢复，已发布的文章不会受到影响。
              <button slot="actions" class="button quiet" type="button" popovertarget="demo-dialog" popovertargetaction="hide">取消</button>
              <button slot="actions" class="button" type="button" popovertarget="demo-dialog" popovertargetaction="hide">确认删除</button>
            </Dialog>
          </div>
        </Specimen>
      </div>
    </StyleguideSection>

    <StyleguideSection id="navigation">
      <div class="stack">
        <Specimen label="面包屑">
          <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '文章', href: '/notes' }, { label: '为平静而设计' }]} />
        </Specimen>
        <Specimen label="分栏标签">
          <Tabs
            current="#navigation"
            label="分栏示例"
            items={[
              { label: '概览', href: '#navigation' },
              { label: '文章', href: '#cards', count: notes.length },
              { label: '数据', href: '#data-display' },
              { label: '设置', href: '#forms' },
            ]}
          />
        </Specimen>
        <Specimen label="步骤条">
          <Steps current={1} steps={signupSteps} />
        </Specimen>
        <Specimen label="分页 · 中间页">
          <Pagination currentPage={4} totalPages={8} basePath="/elements" label="分页组件示例" />
        </Specimen>
        <Specimen label="分页 · 首页，上一页禁用">
          <Pagination currentPage={1} totalPages={3} basePath="/elements" label="分页首页示例" />
        </Specimen>
      </div>
    </StyleguideSection>

    <StyleguideSection id="cards">
      <div class="stack">
        <div>
          {notes.slice(0, 2).map((note, index) => <NoteCard note={note} index={index} />)}
        </div>
        <div class="grid">
          <Card eyebrow="项目 / 2026" title="宣纸设计系统" description="一套为中文阅读优化的静态网站模板。" href="#cards">
            <Fragment slot="footer"><Pill label="Astro" /><Pill label="零 JS" tone="quiet" /></Fragment>
          </Card>
          <Card eyebrow="服务" title="产品设计咨询" description="从信息架构到界面细节，陪伴团队完成一次完整迭代。">
            <Fragment slot="footer"><Icon name="clock" size={14} />每周二、四开放预约</Fragment>
          </Card>
        </div>
        <Specimen label="折叠面板 · 同组互斥展开">
          <Accordion items={faqItems} name="faq" open={0} />
        </Specimen>
        <Specimen label="时间线">
          <Timeline items={timelineItems} />
        </Specimen>
      </div>
    </StyleguideSection>

    <StyleguideSection id="data-display">
      <div class="stack">
        <div class="grid">
          <MetricCard label="本月请求" value="2.46M" change="+12.4%" helper="较上月" tone="healthy" />
          <MetricCard label="错误率" value="0.08%" change="-0.02%" helper="过去 24 小时" tone="healthy" />
        </div>
        <div class="grid charts">
          <Specimen>
            <Sparkline values={trafficTrend} label="网络吞吐量" unit=" MB/s" />
          </Specimen>
          <Specimen>
            <DonutChart title="已使用" value="68%" segments={storageSegments} />
          </Specimen>
        </div>
        <Specimen>
          <div class="row">
            <StatusBadge tone="healthy" label="运行正常" pulse />
            <StatusBadge tone="warning" label="需要关注" />
            <StatusBadge tone="critical" label="服务异常" />
          </div>
          <ProgressBar label="CPU 使用率" value={46} />
          <ProgressBar label="内存使用率" value={76} />
          <ProgressBar label="磁盘使用率" value={93} />
        </Specimen>
        <DataTable caption="节点状态示例" columns={nodeTable.columns} rows={nodeTable.rows} />
        <a class="dashboard-link" href={withBase('/dashboard')}>查看完整仪表盘示例 <span>→</span></a>
      </div>
    </StyleguideSection>

    <StyleguideSection id="content-tools">
      <div class="content-samples">
        <TableOfContents
          title="文章目录"
          items={[
            { id: 'content-tools', label: '部署说明' },
            { id: 'code-example', label: '代码示例', level: 3 },
            { id: 'cards', label: '相关内容' },
          ]}
        />
        <div id="code-example">
          <CodeBlock code={exampleCode} language="TypeScript" filename="src/monitor.ts" />
        </div>
      </div>
    </StyleguideSection>

    <StyleguideSection id="icons">
      <div class="stack">
        <p class="icon-note">图标继承文字颜色和字号，可作为纯装饰元素，也可通过 <code>label</code> 提供无障碍名称。</p>
        <div class="icon-grid">
          {iconNames.map((name) => (
            <div class="icon-item">
              <Icon name={name} size={24} />
              <span>{iconLabels[name]}</span>
              <code>{name}</code>
            </div>
          ))}
        </div>
      </div>
    </StyleguideSection>
  </div>
</BaseLayout>

<script>
  import '@/scripts/copy-code';
</script>

<style>
  .intro {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    align-items: end;
    padding: clamp(5rem, 10vw, 9rem) 0;
  }

  .intro .eyebrow {
    grid-column: 1 / -1;
  }

  .intro-aside > p {
    margin: 0 0 1.5rem;
    color: var(--muted);
  }

  .catalog {
    padding-bottom: 8rem;
  }

  code {
    color: var(--muted);
    font-family: var(--sans);
    font-size: var(--text-xs);
  }

  /* 通用布局：纵向堆叠、两列网格与横向排列 */
  .stack {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .stack.compact {
    gap: 0.75rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* 颜色 */
  .colors {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .swatch > span {
    display: block;
    aspect-ratio: 1;
    margin-bottom: 0.8rem;
