---
import Field from '@/components/forms/Field.astro';

interface Props {
  id: string;
  label: string;
  name?: string;
  type?: 'text' | 'email' | 'password' | 'search' | 'url' | 'tel' | 'number';
  value?: string;
  placeholder?: string;
  hint?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  multiline?: boolean;
  rows?: number;
}

const {
  id,
  label,
  name = id,
  type = 'text',
  value,
  placeholder,
  hint,
  error,
  required = false,
  disabled = false,
  multiline = false,
  rows = 4,
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [hintId, errorId].filter(Boolean).join(' ') || undefined;
const controlProps = {
  id,
  name,
  placeholder,
  required,
  disabled,
  class: 'control',
  'aria-invalid': error ? 'true' as const : undefined,
  'aria-describedby': describedBy,
};
---

<Field label={label} for={id} hint={hint} hintId={hintId} error={error} errorId={errorId} required={required}>
  {multiline ? <textarea {...controlProps} rows={rows}>{value}</textarea> : <input {...controlProps} type={type} value={value} />}
</Field>

<style>
  textarea {
    min-height: 6rem;
    resize: vertical;
  }
</style>
