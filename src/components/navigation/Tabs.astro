---
import { withBase } from '@/lib/urls';

interface Item {
  label: string;
  href: string;
  count?: number;
}

interface Props {
  items: Item[];
  current: string;
  label?: string;
}

const { items, current, label = '分栏导航' } = Astro.props;
---

<nav class="tabs" aria-label={label}>
  <ul>
    {items.map((item) => (
      <li>
        <a href={withBase(item.href)} aria-current={item.href === current ? 'page' : undefined}>
          {item.label}
          {item.count !== undefined && <span class="count">{item.count}</span>}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tabs {
    overflow-x: auto;
  }

  ul {
    display: flex;
    gap: 1.8rem;
    min-width: max-content;
    box-shadow: inset 0 -1px 0 var(--line);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    padding: 0.8rem 0;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    font-family: var(--sans);
    font-size: 0.8rem;
    text-decoration: none;
    white-space: nowrap;
  }

  a:hover {
    color: var(--ink);
  }

  a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .count {
    min-width: 1.4rem;
    padding: 0 0.3rem;
    color: var(--muted);
    background: var(--paper-deep);
    font-size: 0.64rem;
    text-align: center;
  }

  a[aria-current='page'] .count {
    color: var(--paper);
    background: var(--ink);
  }
</style>
