---
import { navLinks, SITE } from '@/data/site';

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === href : pathname.startsWith(href);
---

<header class="header">
  <div class="container header-inner">
    <a class="mark" href="/" aria-label={`${SITE.name}的首页`}>
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <path d="M24 2v44M2 24h44M8.5 8.5l31 31M39.5 8.5l-31 31" />
      </svg>
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="主要导航">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 82px;
  }

  .mark {
    display: inline-flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
  }

  .mark svg {
    width: 26px;
    color: var(--accent);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  nav ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.4rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  nav a {
    padding-block: 0.5rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.82rem;
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  @media (max-width: 480px) {
    .header-inner {
      min-height: 68px;
    }

    .mark span {
      display: none;
    }

    nav ul {
      gap: 0.85rem;
    }

    nav a {
      font-size: 0.75rem;
    }
  }
</style>
